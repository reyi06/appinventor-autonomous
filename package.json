{
  "name": "appinventor-autonomous",
  "version": "2.1.1",
  "description": "MCP server that drives MIT App Inventor: designer, Blockly, .aia export, APK build and emulator testing.",
  "type": "module",
  "main": "mcp/server.js",
  "bin": {
    "appinventor-mcp": "bin/appinventor-mcp.js"
  },
  "files": [
    "bin/",
    "mcp/",
    "extension/",
    "docs/",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node mcp/server.js",
    "selftest": "node tests/mcp-smoke.mjs",
    "security": "node tests/security.mjs",
    "corpus": "node tests/corpus.mjs",
    "test": "node tests/mcp-smoke.mjs && node tests/security.mjs && node tests/layout.mjs && node tests/corpus.mjs",
    "layout": "node tests/layout.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "app-inventor",
    "android",
    "low-code",
    "blockly",
    "automation",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/reyi06/appinventor-autonomous.git"
  },
  "bugs": {
    "url": "https://github.com/reyi06/appinventor-autonomous/issues"
  },
  "homepage": "https://github.com/reyi06/appinventor-autonomous#readme"
}
